includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    # 10, not max: max moves with every PHPStan release and would turn a
    # routine dependency update into a red build.
    level: 10
    paths:
        - src
        - tests/Fixtures
        - bin
    tmpDir: .phpstan.cache
    strictRules:
        # Laravel forwards instance calls through __call, and the builder and
        # router APIs used here are instance methods that larastan reports as
        # static. This rule cannot tell the two apart in a Laravel codebase.
        dynamicCallOnStaticMethod: false
